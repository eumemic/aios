#!/usr/bin/env python3
"""``aios-memory-embed-backfill`` — fill NULL ``memories.embedding`` rows (#1629).

Hybrid memory recall writes embeddings post-commit and DECOUPLED: a provider
failure (or a memory created before migration 0196) leaves ``embedding`` NULL,
so the row is found by the FTS arm only. This sweep embeds those rows with
``AIOS_MEMORY_EMBEDDING_MODEL`` and writes them back through the
content-hash-guarded ``update_memory_embedding`` (no ``MemoryVersion`` bump).
Idempotent and resumable; rows that still fail stay NULL for the next run.

Usage:
  bin/aios-memory-embed-backfill [--batch-size N] [--max-rows N]
"""

from __future__ import annotations

import argparse
import asyncio
import sys


async def _main(batch_size: int, max_rows: int | None) -> int:
    from aios.config import get_settings
    from aios.db import queries
    from aios.db.pool import create_pool
    from aios.services.memory_embedding import Embedded, embed_and_store

    settings = get_settings()
    if not settings.memory_embedding_model:
        print("AIOS_MEMORY_EMBEDDING_MODEL is not set; nothing to do.", file=sys.stderr)
        return 2
    pool = await create_pool(settings.db_url, min_size=1, max_size=2)
    embedded = skipped = 0
    after: str | None = None
    try:
        while max_rows is None or embedded + skipped < max_rows:
            async with pool.acquire() as conn:
                batch = await queries.list_memories_missing_embedding(
                    conn, limit=batch_size, after_id=after
                )
            if not batch:
                break
            for memory_id, account_id, content, sha in batch:
                outcome = await embed_and_store(
                    pool,
                    account_id=account_id,
                    memory_id=memory_id,
                    content=content,
                    content_sha256=sha,
                )
                if isinstance(outcome, Embedded):
                    embedded += 1
                else:
                    skipped += 1
                after = memory_id
    finally:
        await pool.close()
    print(f"embedded={embedded} skipped={skipped}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0] if __doc__ else None)
    parser.add_argument("--batch-size", type=int, default=100)
    parser.add_argument("--max-rows", type=int, default=None)
    args = parser.parse_args()
    return asyncio.run(_main(args.batch_size, args.max_rows))


if __name__ == "__main__":
    sys.exit(main())
